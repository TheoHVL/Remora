{
  "name": "remora",
  "version": "0.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "remora",
      "version": "0.0.0",
      "license": "MIT",
      "workspaces": [
        "apps/*",
        "packages/*"
      ],
      "engines": {
        "node": ">=22"
      }
    },
    "apps/desktop": {
      "name": "@remora/desktop",
      "version": "0.0.0",
      "license": "MIT"
    },
    "apps/server": {
      "name": "@remora/server",
      "version": "0.0.0",
      "license": "MIT"
    },
    "node_modules/@remora/desktop": {
      "resolved": "apps/desktop",
      "link": true
    },
    "node_modules/@remora/server": {
      "resolved": "apps/server",
      "link": true
    },
    "node_modules/@remora/shared": {
      "resolved": "packages/shared",
      "link": true
    },
    "packages/shared": {
      "name": "@remora/shared",
      "version": "0.0.0",
      "license": "MIT"
    }
  }
}
